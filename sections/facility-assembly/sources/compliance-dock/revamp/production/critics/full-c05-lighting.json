{
  "review": "Compliance dock full-cycle-05 independent lighting / atmosphere critic",
  "category": 5,
  "category_name": "Localized lighting, depth and bleak atmosphere without hiding geometry",
  "score": 94,
  "max_score": 100,
  "category_gate": "PASS: 94 > 93; zero critical and zero lighting visual veto findings",
  "source_sha256": "cf5b4c12c6567b142a060c2a8878e767ef001d192933d9fa9c08c0e61257d035",
  "beauty_manifest_sha256": "8e978235fe7d072935d9ac051126375c31c76ff6c974b2a1ac10ec32909118cb",
