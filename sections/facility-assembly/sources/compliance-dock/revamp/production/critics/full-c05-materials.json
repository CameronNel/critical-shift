  "scores": {
    "4": {
      "name": "Tactile material identity and UV/texture discipline",
      "score": 95,
      "threshold_strictly_greater_than": 93,
      "pass": true,
      "evidence": [
        {
          "images": [
            "full-cycle-05/C05_CONVEYOR_LEAD_TUNNEL.png",
            "full-cycle-05/HERO_CARGO.png",
            "full-cycle-05-neutral/C05_CONVEYOR_LEAD_TUNNEL.png"
          ],
          "region": "machine surround, tunnel curtain, rollers and cargo upper latches",
          "finding": "Blue painted housing, controlled grey surround/rollers, matte dark curtain and paper custody label remain distinct. Neutral illumination reveals broad painted roughness variation and wear directly below the cargo latches; none becomes mirror chrome or uniformly glossy plastic."
        },
        {
          "images": [
            "full-cycle-05/C08_CONCEALED_SUPPORT_H1.png",
            "full-cycle-05/HERO_TROLLEY.png",
            "full-cycle-05-neutral/HERO_TROLLEY.png"
          ],
          "region": "shroud centre/shoulders, straps, rails and wheels",
          "finding": "Matte fabric carries broad folds and restrained weave. Thin darker straps, bare rails, painted underframe and dark wheels separate. The response is cloth over a working trolley, with no noisy full-scene grunge."
        },
        {
          "images": [
            "full-cycle-05/DETAIL_CHECKIN.png",
            "full-cycle-05/C03_CHECKIN_COUNTER.png",
            "full-cycle-05/C07_OFFICE_INTERIOR.png",
            "full-cycle-05-neutral/C07_OFFICE_INTERIOR.png"
          ],
          "region": "counter work surface/edge and office desk/chair/window",
          "finding": "Paper, folded cloth, olive writing pad, metallic edge, clipboard and stamp are visually different. Glazing has a different reflective/transmissive response from the furniture and wall."
        },
        {
          "images": [
            "full-cycle-05/HERO_UTILITIES.png",
            "full-cycle-05-neutral/HERO_UTILITIES.png"
          ],
          "region": "wall, three light electrical housings, silver conduit and left cabinets",
          "finding": "Wall texture stays subtle at this useful distance. Chalkier light housings and controlled conduit highlights separate from the blue painted cabinet faces; cabinet wear is concentrated around handles."
        },
        {
          "images": [
            "full-cycle-05-uv-standard/C05_CONVEYOR_LEAD_TUNNEL.png",
            "full-cycle-05-uv-standard/C07_OFFICE_INTERIOR.png",
            "full-cycle-05-uv-standard/HERO_TROLLEY.png",
            "full-cycle-05-uv-standard/HERO_UTILITIES.png",
            "full-cycle-05-uv/HERO_SCANNER.png",
            "full-cycle-05-uv/HERO_CARGO.png",
            "full-cycle-05-uv/HERO_TROLLEY.png",
            "full-cycle-05-uv/DETAIL_CHECKIN.png"
          ],
          "region": "broad faces and narrow curved fittings",
          "finding": "Broad wall, machine, counter and shroud faces show checker coverage without a gross missing-face patch. Narrow conduits, bin sidewalls and conveyor rollers resolve into compressed bands. Folded counter cloth contains fragmented triangular checker cells. These prevent an immaculate UV-discipline score, although the corresponding beauty textures do not exhibit a large visible seam."
        }
      ],
      "deductions": [
        "Checker aspect compression on narrow cylindrical surfaces is visibly stronger than on adjacent broad faces.",
        "Counter folded-cloth checker breaks into triangular fragments; local texture-direction discipline is weaker than the broad trolley shroud.",
        "Close plaster reveal in DETAIL_CHECKIN/WALL_OFFICE_FRONT carries relatively strong granular relief compared with quiet spawn surfaces, even though it remains contained and is not a scene-wide noise veto."
      ]
    },
    "6": {
      "name": "Approved spawn colour coherence and restrained accents",
      "score": 97,
      "threshold_strictly_greater_than": 93,
      "pass": true,
      "evidence": [
        {
          "images": [
            "spawn-reference/VALIDATE_Spawn.png",
            "spawn-reference/VALIDATE_LockerDoor.png",
            "spawn-reference/VALIDATE_Material_A.png",
            "spawn-reference/BRIEFING_INDIRECT.png",
            "full-cycle-05/C01_ENTRY.png",
            "full-cycle-05/C02_HERO_DOCK.png",
            "full-cycle-05/WALL_OFFICE_FRONT.png"
          ],
          "region": "large wall/trim masses and local orange/blue assets",
          "finding": "Dock institutional pale walls, dark navy/charcoal protection and muted grey flooring share the spawn's broad value/material grammar. Warm orange staff-door/sign/cargo accents echo the approved orange lockers/briefing space without importing the briefing room's whole warm wash."
        },
        {
          "images": [
            "full-cycle-05/CORNER_SW.png",
            "full-cycle-05/CORNER_SE.png",
            "full-cycle-05/CORNER_NW.png",
            "full-cycle-05/CORNER_NE.png",
            "full-cycle-05/WALL_EAST.png",
            "full-cycle-05/WALL_SOUTH.png"
          ],
          "region": "whole-room broad colour blocks and long quiet wall areas",
          "finding": "All corners retain quiet neutral architecture; blue machinery is clustered around its function. Yellow route paint and a few orange surfaces occupy a limited area, preserving bleak workplace restraint."
        },
        {
          "images": [
            "full-cycle-05/HERO_SCANNER.png",
            "full-cycle-05/PLAYER_REVERSE.png",
            "full-cycle-05/PLAYER_PINCH.png",
            "full-cycle-05/HERO_UTILITIES.png"
          ],
          "region": "signals, route markings, utility cabinets and lower wall",
          "finding": "Small red/green/amber status points, yellow route markings and orange panels read as functional accents. They do not create room-wide colour confetti or neon sci-fi trim."
        }
      ],
      "deductions": [
        "Lit machinery/cabinet blue is somewhat brighter and cleaner than the approved spawn's subdued blue wall mass; it competes mildly with local orange authority cues.",
        "The cargo front and scanner title strip form two fairly bright orange accents in the inspection composition, leaving a small amount of palette hierarchy headroom."
      ]
    }
  },
