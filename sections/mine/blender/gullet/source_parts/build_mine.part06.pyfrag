 for hh in [.51,1.06]:pipe(s,'Sump_far_guard',(cx-1.23,cy+1.70,z+hh),(cx+1.23,cy+1.70,z+hh),.029,'paint_ochre')
 # Adjacent service grating, with actual gaps and a structural border.
 for yy in np.arange(19.6,23.6,.12):box(s,'Sump_access_grating',(7.69,yy,floor_z(yy)+.095),(1.05,.027,.065),'steel',.002)
 for xx in [7.14,8.24]:box(s,'Grating_stringer',(xx,21.57,z+.049),(.055,4.04,.13),'dark_steel',.005)
 with s.group('Pump_skid',(10.0,18.50,floor_z(18.5)),rot=(0,0,.05),meta={'interaction':'pump','component':'pump_root'}):
  for y in [-.29,.29]:sweep(s,'Skid_runner',[(-.63,y,.12),(.83,y,.12)],ibeam_profile(.10,.13,.015),'paint_teal')
  for x in [-.50,.65]:box(s,'Skid_crossbar',(x,0,.19),(.10,.66,.11),'dark_steel',.009)
  # Finned motor and a non-cylindrical volute housing make the pump recognizable.
  lathe(s,'Pump_motor',[(.12,-.26),(.17,-.21),(.18,.18),(.145,.28)],'paint_teal',(.30,0,.43),(0,math.pi/2,0),n=32)
  for a in np.linspace(0,2*math.pi,12,endpoint=False):
   x0=(-.04,.15*math.cos(a),.43+.15*math.sin(a));x1=(.50,.15*math.cos(a),.43+.15*math.sin(a))
   pipe(s,'Motor_cooling_fin',x0,x1,.015,'dark_steel',6)
  outline=[]
  for a in np.linspace(0,2*math.pi,28,endpoint=False):
   r=.205+.058*((a%(2*math.pi))/(2*math.pi));outline.append((r*math.cos(a),r*math.sin(a)))
  profile_extrude(s,'Centrifugal_volute',outline,.16,'paint_ochre',(-.33,0,.43),axis='X')
  pipe(s,'Pump_suction',(-.42,0,.43),(-.74,0,.43),.063,'dark_steel')
  line(s,'Suction_hose',[(-.74,0,.43),(-.89,.26,.25),(-.85,1.15,.08),(-.45,1.85,-.08),(-.43,2.18,-.40)],.070,'rubber')
  line(s,'Discharge_pipe',[(-.29,.13,.61),(-.29,.22,.87),(-.29,.50,1.01),(.40,.56,1.01),(.86,.6,.87)],.057,'steel')
  gauge(s,'Pump_delivery_gauge',(-.03,.49,1.22),.09)
  box(s,'Pump_switch_box',(.40,-.16,.71),(.22,.20,.21),'paint_cream',.02)
  box(s,'Pump_switch',(.40,-.27,.73),(.060,.020,.081),'paint_red',.007)
