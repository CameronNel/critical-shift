  # Pressed scoop: broad concavity, shoulder, and sharpened lower outline.
  outline=[(-.12,.34),(-.17,.23),(-.145,.06),(0,0),(.145,.06),(.17,.23),(.12,.34)]
  vv=[(x,.038*(abs(x)/.17)**1.5,z) for x,z in outline]+[(0,-.048,.20)]
  ff=[(i,(i+1)%7,7) for i in range(7)]
  s.add('Pressed_shovel_blade',vv,ff,'steel')
  pipe(s,'Shovel_socket',(0,0,.25),(0,.018,.48),.036,'dark_steel')
  pipe(s,'Shovel_shaft',(0,.018,.37),(0,.035,1.18),.021,'timber')
  line(s,'D_handle',[(-.095,.035,1.29),(-.092,.035,1.39),(.092,.035,1.39),(.095,.035,1.29),(0,.035,1.14),(-.095,.035,1.29)],.018,'paint_ochre')
  pipe(s,'D_handle_grip',(-.07,.035,1.39),(.07,.035,1.39),.028,'rubber')


