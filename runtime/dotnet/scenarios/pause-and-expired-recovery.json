{
  "name": "pause-and-expired-recovery",
  "seed": 42,
  "duration": 20000,
  "pause": true,
  "steps": [
    {"op": "impact", "actor": 1, "seq": 1, "severity": "Knockdown", "delay": 100, "expect": "Applied"},
    {"op": "grab", "actor": 2, "seq": 1, "revision": 0, "expect": "Applied"},
    {"op": "advance", "time": 50, "expect": "Running"},
    {"op": "pause", "expect": "Applied"},
    {"op": "advance", "time": 10000, "assert": {"elapsed": 50, "claims": 0, "pose": "Down"}, "expect": "Paused"},
    {"op": "beginRecovery", "actor": 1, "episode": 1, "revision": 1, "expect": "Paused"},
    {"op": "resume", "expect": "Applied"},
    {"op": "advance", "time": 10050, "expect": "Running"},
    {"op": "beginRecovery", "actor": 1, "episode": 1, "revision": 1, "expect": "Applied"},
    {"op": "advance", "time": 15050, "assert": {"pose": "Down", "revision": 3, "attempt": 1}, "expect": "Running"},
    {"op": "completeRecovery", "actor": 1, "attempt": 1, "clearance": "Safe", "expect": "StaleRecovery"},
    {"op": "beginRecovery", "actor": 1, "episode": 1, "revision": 1, "expect": "RevisionConflict"},
    {"op": "beginRecovery", "actor": 1, "episode": 1, "revision": 3, "expect": "Applied"},
    {"op": "completeRecovery", "actor": 1, "attempt": 2, "clearance": "Safe", "expect": "Applied"},
    {"op": "advance", "time": 40000, "assert": {"workers": 0, "claims": 0, "connections": 0, "timers": 0, "outcome": "TimedOut", "elapsed": 20000}, "expect": "Ended"},
    {"op": "completeRecovery", "actor": 1, "attempt": 2, "clearance": "Safe", "expect": "WorldEnded"}
  ]
}
