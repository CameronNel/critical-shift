{
  "name": "cleanup-and-trace",
  "seed": 42,
  "duration": 20000,
  "pause": true,
  "traceCapacity": 4,
  "steps": [
    {"op": "impact", "actor": 1, "seq": 1, "severity": "Knockdown", "delay": 0, "expect": "Applied", "hazard": 800, "cause": 900},
    {"op": "beginRecovery", "actor": 1, "episode": 1, "revision": 1, "expect": "Applied"},
    {"op": "pause", "expect": "Applied"},
    {"op": "cancelRecovery", "actor": 1, "attempt": 1, "expect": "Cancelled"},
    {"op": "resume", "expect": "Applied"},
    {"op": "beginRecovery", "actor": 1, "episode": 1, "revision": 3, "expect": "Applied"},
    {"op": "completeRecovery", "actor": 1, "attempt": 2, "clearance": "Safe", "expect": "Applied"},
    {"op": "advance", "time": 10, "expect": "Running"},
    {"op": "advance", "time": 20, "expect": "Running"},
    {"op": "assert", "assert": {"traceDropped": true, "claims": 0, "workers": 4, "pose": "Upright"}, "expect": "Checked"},
    {"op": "restart", "assert": {"traceDropped": false, "elapsed": 0, "revision": 0, "workers": 4}, "expect": "Running"},
    {"op": "disconnect", "epoch": "previous", "actor": 1, "assert": {"connections": 4, "workers": 4}, "expect": "NoChange"},
    {"op": "impact", "epoch": "previous", "actor": 1, "seq": 1, "severity": "Knockdown", "delay": 0, "expect": "WrongEpoch", "hazard": 800, "cause": 900},
    {"op": "grab", "actor": 1, "seq": 1, "revision": 0, "expect": "Applied"},
    {"op": "disconnect", "actor": 1, "assert": {"claims": 0, "workers": 3, "workerPresent": false}, "expect": "Disconnected"}
  ]
}
