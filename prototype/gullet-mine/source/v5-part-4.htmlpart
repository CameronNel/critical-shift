// Input
const controls=new PointerLockControls(camera,renderer.domElement);
const start=document.getElementById('start');
document.getElementById('enter').addEventListener('click',()=>{start.style.display='none';if(!coarse)controls.lock()});
renderer.domElement.addEventListener('click',()=>{if(!coarse&&start.style.display==='none')controls.lock()});
const keys={};
addEventListener('keydown',e=>{
  keys[e.code]=true;
  if(e.code==='KeyF')toggleLantern();
  if(e.code==='KeyG'){ghost=!ghost;toast(ghost?'Debug ghost ON':'Collision ON');if(!ghost)resetPlayer()}
});
addEventListener('keyup',e=>keys[e.code]=false);

let yaw=0,pitch=0,mobileLook=false,last=null;
const look=document.getElementById('look');
look.addEventListener('pointerdown',e=>{mobileLook=true;last={x:e.clientX,y:e.clientY};look.setPointerCapture(e.pointerId)});
look.addEventListener('pointermove',e=>{
  if(!mobileLook)return;const dx=e.clientX-last.x,dy=e.clientY-last.y;last={x:e.clientX,y:e.clientY};
  yaw-=dx*.0041;pitch=clamp(pitch-dy*.0037,-1.28,1.28);camera.rotation.set(pitch,yaw,0);
});
look.addEventListener('pointerup',()=>mobileLook=false);

const stick=document.getElementById('stick'),knob=document.getElementById('knob');let joy={x:0,y:0};
function setJoy(e){const r=stick.getBoundingClientRect(),cx=r.left+r.width/2,cy=r.top+r.height/2;let dx=e.clientX-cx,dy=e.clientY-cy;const max=r.width*.34,l=Math.hypot(dx,dy)||1;if(l>max){dx*=max/l;dy*=max/l}joy.x=dx/max;joy.y=dy/max;knob.style.transform=`translate(${dx}px,${dy}px)`}
stick.addEventListener('pointerdown',e=>{stick.setPointerCapture(e.pointerId);setJoy(e)});stick.addEventListener('pointermove',e=>{if(stick.hasPointerCapture(e.pointerId))setJoy(e)});stick.addEventListener('pointerup',()=>{joy.x=joy.y=0;knob.style.transform='translate(0,0)'});
let jumpQueued=false;document.getElementById('jump').addEventListener('pointerdown',()=>jumpQueued=true);document.getElementById('lamp').addEventListener('pointerdown',toggleLantern);

const handLamp=new THREE.SpotLight(0xffdda0,coarse?82:95,28,Math.PI/5,.55,2);handLamp.position.set(.18,-.05,.14);handLamp.target.position.set(0,-.15,-4);camera.add(handLamp);camera.add(handLamp.target);scene.add(camera);
let lampOn=true;
function toggleLantern(){lampOn=!lampOn;handLamp.intensity=lampOn?(coarse?82:95):0;toast(lampOn?'Hand lantern lit':'Hand lantern snuffed')}
function toast(s){const e=document.getElementById('toast');e.textContent=s;e.style.opacity=1;clearTimeout(toast.t);toast.t=setTimeout(()=>e.style.opacity=0,1100)}

function controlsStep(dt){
  const forward=(keys.KeyW?1:0)-(keys.KeyS?1:0)-joy.y;
  const side=(keys.KeyD?1:0)-(keys.KeyA?1:0)+joy.x;
  const sprint=keys.ShiftLeft||keys.ShiftRight;
  if(ghost){
    const speed=(sprint?8.5:5.2)*dt;
    camera.position.addScaledVector(getForwardVector(),forward*speed);
    camera.position.addScaledVector(getSideVector(),side*speed);
    if(keys.Space)camera.position.y+=5*dt;if(keys.ControlLeft)camera.position.y-=5*dt;
    return;
  }
  const accel=playerOnFloor?(sprint?31:23):8;
  if(forward)playerVelocity.add(getForwardVector().multiplyScalar(forward*accel*dt));
  if(side)playerVelocity.add(getSideVector().multiplyScalar(side*accel*dt));
  if((keys.Space||jumpQueued)&&playerOnFloor)playerVelocity.y=5.6;
  jumpQueued=false;

  let damping=Math.exp(-8*dt)-1;
  if(!playerOnFloor){playerVelocity.y-=20*dt;damping*=.12}
  playerVelocity.addScaledVector(playerVelocity,damping);
  const deltaPos=playerVelocity.clone().multiplyScalar(dt);
  playerCollider.translate(deltaPos);
  playerCollisions();
  camera.position.copy(playerCollider.end);
  if(camera.position.y<-8)resetPlayer();
}

// Zone labels
const zones=[['Maw Camp',0,22],['The Crooked Rail',0,6],['Blackshaft Bridge',.3,-10.5],['Drowned Pocket',13,-27],['Saint Glimmer',24,-41],['Powderworks',7,-58],["Foreman's Vault",-10,-73]];
const zoneEl=document.getElementById('zone');
function updateZone(){
  let best=zones[0],bd=Infinity;for(const z of zones){const d=(camera.position.x-z[1])**2+(camera.position.z-z[2])**2;if(d<bd){bd=d;best=z}}zoneEl.textContent=best[0];
}

// Animation
const clock=new THREE.Clock();
function animate(){
  requestAnimationFrame(animate);
  const dt=Math.min(clock.getDelta(),.033),t=clock.elapsedTime;
  controlsStep(dt);updateZone();
  mats.water.map.offset.x=t*.012;mats.water.map.offset.y=t*.006;
  fireLight.intensity=34+Math.sin(t*8.2)*3+Math.sin(t*13.7)*2;
  for(const f of flickers){const pulse=1+Math.sin(t*f.speed+f.phase)*.10+Math.sin(t*f.speed*1.71+f.phase*.6)*.04;if(f.light)f.light.intensity=f.base*pulse;f.aura.material.opacity=.13+pulse*.025}
  dust.rotation.y=t*.006;
  composer.render();
}
animate();

addEventListener('resize',()=>{
  camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight);composer.setSize(innerWidth,innerHeight);bloom.setSize(innerWidth,innerHeight);
});
</script>
</body>
</html>
