// Signs
function sign(x,y,z,text,yaw=0){
  const g=new THREE.Group();
  g.add(box(2.4,.84,.13,mats.wood,0,0,0));
  // Two grounded posts make the sign an actual mine prop rather than a floating UI board.
  g.add(box(.16,y,.16,mats.woodDark,-.72,-y/2,0));
  g.add(box(.16,y,.16,mats.woodDark,.72,-y/2,0));
  const c=document.createElement('canvas');c.width=512;c.height=180;const q=c.getContext('2d');q.fillStyle='#ecd39c';q.font='bold 46px Georgia';q.textAlign='center';q.textBaseline='middle';q.fillText(text,256,91);
  const tx=new THREE.CanvasTexture(c);tx.colorSpace=THREE.SRGBColorSpace;const l=new THREE.Mesh(new THREE.PlaneGeometry(2.15,.68),new THREE.MeshBasicMaterial({map:tx,transparent:true,side:THREE.DoubleSide}));l.position.z=.071;g.add(l);
  g.position.set(x,y,z);g.rotation.y=yaw;g.traverse(o=>{if(o.isMesh){o.castShadow=o.receiveShadow=true}});visual.add(g);
}
