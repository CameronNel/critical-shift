for(let z=-15.7;z<-5;z+=1.55){ropeBetween(new THREE.Vector3(-1.35,.24,z),new THREE.Vector3(-1.35,1.92,z),.028);ropeBetween(new THREE.Vector3(1.95,.24,z),new THREE.Vector3(1.95,1.92,z),.028)}
