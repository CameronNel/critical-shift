// Cathedral: hero ore formation is built from faceted octahedra, not cones.
function crystalShard(x,y,z,sx,sy,sz,mat,rx=0,ry=0,rz=0){
  const m=new THREE.Mesh(new THREE.OctahedronGeometry(1,0),mat);m.position.set(x,y,z);m.scale.set(sx,sy,sz);m.rotation.set(rx,ry,rz);m.castShadow=m.receiveShadow=true;visual.add(m);return m;
}
