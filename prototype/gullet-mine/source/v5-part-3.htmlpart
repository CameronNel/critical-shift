// Embedded ore veins. Each seam is mounted to a cave wall, not dropped on the floor.
function oreVeinAt(t,sideSign=1,type='teal',scale=1){
  const {p,side,tan}=basisAt(t),w=profile(t,widths)*.78;
  const inward=side.clone().multiplyScalar(-sideSign),wall=p.clone().addScaledVector(side,sideSign*w);wall.y=1.8+scale*.55;
  const g=new THREE.Group();
  // irregular dark host-rock plate
  const host=new THREE.Mesh(new THREE.IcosahedronGeometry(1.0,1),mats.oreRock);host.scale.set(1.55*scale,1.05*scale,.22*scale);g.add(host);
  const cm=type==='blue'?mats.crystalBlue:mats.crystal;
  const shardData=[
    [-.62,.18,.18,.24,.66,-.20],[.02,.36,.22,.28,.88,.08],[.52,.10,.20,.22,.58,.22],
    [-.25,-.30,.17,.19,.52,-.30],[.38,-.25,.16,.18,.48,.28]
  ];
  shardData.forEach(([x,y,z,sx,sy,rz],i)=>{
    const sh=new THREE.Mesh(new THREE.OctahedronGeometry(.55,0),cm);sh.scale.set(sx*scale,sy*scale,.24*scale);sh.position.set(x*scale,y*scale,.20*scale);sh.rotation.set(.10,(i-2)*.18,rz);g.add(sh);
  });
  // chalky mineral fringe makes seam look embedded
  [[-1.0,.0,.02,.34],[-.72,-.52,.02,.27],[.80,.48,.01,.29],[.92,-.26,.0,.22]].forEach(([x,y,z,s])=>{
    const r=new THREE.Mesh(new THREE.DodecahedronGeometry(s*scale,0),mats.rockWarm);r.scale.z=.35;r.position.set(x*scale,y*scale,z);g.add(r);
  });
  g.position.copy(wall);
  const yaw=Math.atan2(inward.x,inward.z);g.rotation.y=yaw;
  g.rotation.z=(sideSign>0?-.08:.08);
  g.traverse(o=>{if(o.isMesh){o.castShadow=o.receiveShadow=true}});visual.add(g);
}
oreVeinAt(.105,-1,'teal',.85);oreVeinAt(.205,1,'blue',.72);
oreVeinAt(.392,-1,'blue',1.0);oreVeinAt(.430,1,'teal',.88);
oreVeinAt(.545,-1,'teal',1.35);oreVeinAt(.575,1,'blue',1.05);oreVeinAt(.610,-1,'teal',.86);
oreVeinAt(.755,1,'teal',.70);

