const caveCurve=new THREE.CatmullRomCurve3(pathPts,false,'catmullrom',.38);
function profile(t,arr){const q=t*(arr.length-1),i=Math.floor(q),f=q-i;return THREE.MathUtils.lerp(arr[Math.min(i,arr.length-1)],arr[Math.min(i+1,arr.length-1)],f)}
function basisAt(t){
  const p=caveCurve.getPointAt(t),tan=caveCurve.getTangentAt(t).setY(0).normalize(),side=new THREE.Vector3(-tan.z,0,tan.x);
  return{p,tan,side};
}
function makeTunnel(){
  const seg=190,rad=24,pos=[],uv=[],idx=[],cols=[];const col=new THREE.Color();
  for(let i=0;i<=seg;i++){
    const t=i/seg,{p,side}=basisAt(t),rx=profile(t,widths),ry=profile(t,heights);
    for(let j=0;j<=rad;j++){
      const a=j/rad*Math.PI*2,cs=Math.cos(a),sn=Math.sin(a);
      const authoredRough=1+Math.sin(i*.47+j*1.37)*.025+Math.sin(i*.16-j*.59)*.018;
      const v=p.clone().addScaledVector(side,cs*rx*authoredRough);v.y+=sn*ry*authoredRough;
      if(sn<-.68)v.y=Math.min(v.y,-.68);
      pos.push(v.x,v.y,v.z);uv.push(t*15,j/rad*2.6);
      const lum=.42+.13*(sn*.5+.5)+Math.sin(i*.21+j*.71)*.018;col.setHSL(.42,.09,lum);cols.push(col.r,col.g,col.b);
    }
  }
  for(let i=0;i<seg;i++)for(let j=0;j<rad;j++){const a=i*(rad+1)+j,b=a+rad+1;idx.push(a,b,a+1,b,b+1,a+1)}
  const g=new THREE.BufferGeometry();g.setAttribute('position',new THREE.Float32BufferAttribute(pos,3));g.setAttribute('uv',new THREE.Float32BufferAttribute(uv,2));g.setAttribute('color',new THREE.Float32BufferAttribute(cols,3));g.setIndex(idx);g.computeVertexNormals();
  const m=new THREE.Mesh(g,mats.cave);m.receiveShadow=true;visual.add(m);
}
function makeFloorRibbon(){
  const seg=190,pos=[],uv=[],idx=[];
  for(let i=0;i<=seg;i++){
    const t=i/seg,{p,side}=basisAt(t),w=profile(t,widths)*.82;
    const l=p.clone().addScaledVector(side,-w),r=p.clone().addScaledVector(side,w);l.y=r.y=-.04;
    pos.push(l.x,l.y,l.z,r.x,r.y,r.z);uv.push(0,t*18,2.5,t*18);
  }
  for(let i=0;i<seg;i++){const a=i*2;idx.push(a,a+2,a+1,a+1,a+2,a+3)}
  const g=new THREE.BufferGeometry();g.setAttribute('position',new THREE.Float32BufferAttribute(pos,3));g.setAttribute('uv',new THREE.Float32BufferAttribute(uv,2));g.setIndex(idx);g.computeVertexNormals();
  const m=new THREE.Mesh(g,mats.floor);m.receiveShadow=true;visual.add(m);
}
makeTunnel();makeFloorRibbon();

// Simple, robust collision proxy: floors and walls follow the cave in short segments.
// Visual geometry can be fancy; collision geometry stays intentionally boring.
const shaftCenter=new THREE.Vector3(.3,0,-10.5);
for(let i=0;i<120;i++){
  const t0=i/120,t1=(i+1)/120,tm=(t0+t1)/2;
  const a=basisAt(t0).p,b=basisAt(t1).p,{p,tan,side}=basisAt(tm);
  const len=Math.hypot(b.x-a.x,b.z-a.z)+.22,w=profile(tm,widths)*.82,h=profile(tm,heights);
  const yaw=Math.atan2(tan.x,tan.z);
  const inShaft=(p.z<-4.7&&p.z>-16.2&&Math.hypot(p.x-shaftCenter.x,p.z-shaftCenter.z)<6.45);
  if(!inShaft)addColliderBox(w*2,.50,len,p.x,-.29,p.z,yaw);
  const wallH=Math.max(6.2,h+3.4),wallOffset=w+.43;
  const lp=p.clone().addScaledVector(side,-wallOffset),rp=p.clone().addScaledVector(side,wallOffset);
  addColliderBox(.86,wallH,len,lp.x,wallH/2-.1,lp.z,yaw);
  addColliderBox(.86,wallH,len,rp.x,wallH/2-.1,rp.z,yaw);
}
// Pit rim side platforms, leaving the bridge as the intended crossing.
addColliderBox(4.3,.50,12.6,-5.15,-.29,-10.5,0);
addColliderBox(4.3,.50,12.6,5.75,-.29,-10.5,0);

// Lighting
scene.add(new THREE.HemisphereLight(0xb8d1ca,0x6d4b31,coarse?1.20:1.10));
const key=new THREE.DirectionalLight(0xd5e6df,coarse?.72:.65);key.position.set(-14,23,15);key.castShadow=!coarse;key.shadow.mapSize.set(1024,1024);key.shadow.camera.left=-45;key.shadow.camera.right=45;key.shadow.camera.top=42;key.shadow.camera.bottom=-92;scene.add(key);
const coolFill=new THREE.DirectionalLight(0x749f98,.30);coolFill.position.set(19,12,-39);scene.add(coolFill);
function bounce(x,y,z,color,intensity=18,distance=20){const p=new THREE.PointLight(color,intensity,distance,2);p.position.set(x,y,z);scene.add(p);return p}
bounce(0,4,22,0xffbd79,24,22);bounce(0,4,6,0x7ebfb7,15,18);bounce(.3,4,-10.5,0x6bb6ae,18,20);bounce(13,3.5,-27,0x65ccd2,22,21);bounce(24,4,-41,0x57e6d0,31,25);bounce(7,3.5,-58,0xff8652,21,20);bounce(-10,3.6,-73,0xffbf69,24,22);

// Timber supports: exact centerline placement, feet on y=0.
function timberArchAt(t,widthScale=.68){
  const {p,tan}=basisAt(t),w=profile(t,widths)*widthScale,h=Math.min(5.25,profile(t,heights)*.90),yaw=Math.atan2(tan.x,tan.z);
  const g=new THREE.Group();
  const postGeo=new THREE.BoxGeometry(.48,h,.54),topGeo=new THREE.BoxGeometry(w*2+.45,.52,.58);
  const l=new THREE.Mesh(postGeo,mats.wood),r=l.clone(),top=new THREE.Mesh(topGeo,mats.wood);
  l.position.set(-w,h/2,0);r.position.set(w,h/2,0);l.rotation.z=-.055;r.rotation.z=.055;top.position.set(0,h-.26,0);
  [l,r,top].forEach(m=>{m.castShadow=m.receiveShadow=true;g.add(m)});
  g.position.set(p.x,0,p.z);g.rotation.y=yaw;visual.add(g);
  // colliders are straight and slightly slimmer to avoid snagging
  const side=basisAt(t).side;
  const lp=p.clone().addScaledVector(side,-w),rp=p.clone().addScaledVector(side,w);
  addColliderBox(.42,h,.46,lp.x,h/2,lp.z,yaw);addColliderBox(.42,h,.46,rp.x,h/2,rp.z,yaw);
}
[.040,.078,.116,.154,.198,.242,.306,.486,.530,.575,.661,.704,.754,.804,.872].forEach(t=>timberArchAt(t,t<.33?.66:.59));

// Rail
function railCurve(t0,t1,offset){const pts=[];for(let i=0;i<=75;i++){const t=THREE.MathUtils.lerp(t0,t1,i/75),{p,side}=basisAt(t);const q=p.clone().addScaledVector(side,offset);q.y=.09;pts.push(q)}return new THREE.CatmullRomCurve3(pts)}
for(const off of [-.52,.52]){const rail=new THREE.Mesh(new THREE.TubeGeometry(railCurve(.014,.30,off),100,.052,6,false),mats.rail);rail.castShadow=true;visual.add(rail)}
for(let t=.018;t<.30;t+=.011){const {p,tan}=basisAt(t);addVisualBox(1.56,.11,.22,mats.woodDark,p.x,.055,p.z,Math.atan2(tan.x,tan.z),0)}

// Props, authored positions only
function crate(x,z,s=1,ry=0){
  const g=new THREE.Group(),h=1.0*s,w=1.24*s;
  g.add(box(w,h,w,mats.woodDark,0,h/2,0));
  g.add(box(w+.06,.10,w+.06,mats.wood,0,.09*s,0));g.add(box(w+.06,.10,w+.06,mats.wood,0,.91*s,0));
  g.add(box(.10*s,h+.02,w+.06,mats.wood,0,h/2,0,0,0,.61));
  g.add(box(.10*s,h+.02,w+.06,mats.wood,0,h/2,0,0,0,-.61));
  g.position.set(x,0,z);g.rotation.y=ry;g.traverse(o=>{if(o.isMesh){o.castShadow=o.receiveShadow=true}});visual.add(g);
  addColliderBox(w*.92,h,w*.92,x,h/2,z,ry);
}
function barrel(x,z,ry=0){
  const g=new THREE.Group();const body=cyl(.46,.46,1.16,14,mats.wood,0,.58,0);g.add(body);
  for(const y of [.16,.58,1.00]){const ring=new THREE.Mesh(new THREE.TorusGeometry(.465,.04,6,18),mats.iron);ring.rotation.x=Math.PI/2;ring.position.y=y;g.add(ring)}
  g.position.set(x,0,z);g.rotation.y=ry;g.traverse(o=>{if(o.isMesh){o.castShadow=o.receiveShadow=true}});visual.add(g);
  addColliderBox(.88,1.16,.88,x,.58,z,ry);
}
function mineCart(x,z,ry=0,withOre=false){
  const g=new THREE.Group();const bin=box(1.50,.68,1.90,mats.iron,0,.72,0);g.add(bin);g.add(box(1.22,.16,1.62,mats.woodDark,0,.78,0));
  for(const xx of [-.66,.66])for(const zz of [-.61,.61])g.add(cyl(.21,.21,.13,10,mats.iron,xx,.24,zz,0,0,Math.PI/2));
  if(withOre){
    const oreMat=mats.rockWarm;
    [[-.32,1.11,-.27,.23],[.18,1.12,-.18,.27],[.35,1.10,.24,.20],[-.18,1.18,.32,.22],[.0,1.27,.03,.25]].forEach(([ox,oy,oz,s],i)=>{
      const o=new THREE.Mesh(new THREE.IcosahedronGeometry(s,1),i===1?mats.crystal:oreMat);o.position.set(ox,oy,oz);o.scale.set(1.0,.65,1.1);g.add(o);
    });
  }
  g.position.set(x,0,z);g.rotation.y=ry;g.traverse(o=>{if(o.isMesh){o.castShadow=o.receiveShadow=true}});visual.add(g);
  addColliderBox(1.45,1.22,1.78,x,.61,z,ry);
}
crate(-4.8,23.0,1.05,.18);crate(-5.8,21.7,.78,-.16);barrel(4.9,22.0,.12);barrel(5.8,20.8,-.18);
mineCart(2.35,22.3,-.08,true);mineCart(-.35,3.0,.05,false);

// Fire pit is grounded
const fireLight=new THREE.PointLight(0xff7b33,36,9,2);fireLight.position.set(4.0,.72,24.7);scene.add(fireLight);
[[3.72,24.7,.62],[4.22,24.65,-.55],[4.02,24.43,.18]].forEach(([x,z,r])=>addVisualBox(.15,.15,1.15,mats.woodDark,x,.075,z,r,0));

// Lamps
const flickers=[];
function lampFixture(pos,yaw,color=0xffc46b,real=true){
  const g=new THREE.Group();
  g.add(box(.08,.08,.66,mats.iron,0,.22,.22,-.15,0,0));
  const top=cyl(.14,.20,.14,7,mats.iron,0,-.16,.51);g.add(top);
  const cage=cyl(.16,.16,.32,8,mats.iron,0,-.37,.51);g.add(cage);
  const flame=new THREE.Mesh(new THREE.SphereGeometry(.085,10,8),new THREE.MeshBasicMaterial({color}));flame.scale.set(.70,1.18,.70);flame.position.set(0,-.37,.51);g.add(flame);
  const aura=new THREE.Sprite(new THREE.SpriteMaterial({map:glowTex,color,transparent:true,opacity:.16,depthWrite:false,blending:THREE.AdditiveBlending}));aura.scale.set(.48,.48,.48);aura.position.set(0,-.37,.51);g.add(aura);
  let light=null;if(real){light=new THREE.PointLight(color,coarse?48:56,coarse?9.5:10.5,2);light.position.set(0,-.34,.40);g.add(light)}
  g.position.copy(pos);g.rotation.y=yaw;visual.add(g);flickers.push({light,aura,phase:rand(0,6.28),speed:rand(5.5,8.2),base:real?(coarse?48:56):0});
}
function lampAt(t,sideSign=1,color=0xffc46b,real=true){
  const {p,side}=basisAt(t),w=profile(t,widths)*.80,q=p.clone().addScaledVector(side,sideSign*w);
  q.y=3.05;const inward=side.clone().multiplyScalar(-sideSign),yaw=Math.atan2(inward.x,inward.z);lampFixture(q,yaw,color,real);
}
